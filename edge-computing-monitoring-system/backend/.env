APP_NAME=Edge Monitoring Backend
APP_VERSION=0.2.0

STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://192.168.178.200:30413
S3_IMAGES_BUCKET=captured-images
S3_METADATA_BUCKET=event-metadata
S3_UNSIGNED_REQUESTS=true

MAX_UPLOAD_SIZE_BYTES=5242880
RUN_INFERENCE_ON_UPLOAD=true
YOLO_MODEL_PATH=../object_detection/training/best_k.pt
YOLO_CONFIDENCE_THRESHOLD=0.55
